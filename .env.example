# Local server. Run npm ci once before starting.
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000

# Google OAuth Web application credentials (optional for local use).
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional local AI. Install Ollama separately and pull a small model.
# The planner works without this; AI only enriches curated activity descriptions.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
ENABLE_LOCAL_AI=false

# Optional map providers. Street tiles load only when a user opens a map.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSRM_URL=https://router.project-osrm.org
